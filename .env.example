# ====================================================================
# Safe Environment Configuration Template (.env.example)
# WARNING: NEVER commit real private keys, seed phrases, or API secrets.
# NOTE: The frontend runtime currently connects directly using the
#       official contract address configured in frontend/src/main.js
#       and does not load .env at runtime.
# ====================================================================

# Ethereum Sepolia RPC URL (e.g. Public node, Alchemy, Infura)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key placeholder of test wallet on Sepolia Testnet ONLY
PRIVATE_KEY=replace_with_test_wallet_private_key

# Official Deployed Smart Contract Address on Ethereum Sepolia
CONTRACT_ADDRESS=0xddcd1fb5b165b5a73a970a2adbe4354d638e1f37

# Chain ID (11155111 for Sepolia)
CHAIN_ID=11155111
